## Copy this file to local.properties and fill in your own values.
## local.properties is gitignored and should never be committed.

sdk.dir=/path/to/your/android/sdk

OPENAI_API_KEY=your_openai_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
ASSEMBLY_AI_API_KEY=your_assemblyai_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_REDIRECT_URI=mobile_assistant://spotify-auth-callback
MAPS_API_KEY=your_maps_api_key

## Optional hosted account/credit backend.
## Leave blank for local portfolio/demo builds.
MARVIN_API_BASE_URL=
MARVIN_BILLING_URL=

## Optional Firebase auth. You can also provide app/google-services.json locally.
FIREBASE_API_KEY=your_public_firebase_web_api_key
FIREBASE_APP_ID=your_firebase_android_app_id
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_WEB_CLIENT_ID=your_firebase_web_oauth_client_id.apps.googleusercontent.com
