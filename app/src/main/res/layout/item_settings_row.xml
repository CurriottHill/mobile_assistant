<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="18dp"
    android:paddingEnd="16dp"
    android:paddingBottom="18dp">

    <View
        android:id="@+id/rowDot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/bg_status_dot_attention" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/rowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/row_accessibility_title"
            android:textColor="@color/home_panel_title"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rowStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="@string/status_action_needed"
            android:textColor="@color/home_panel_body"
            android:textSize="13sp" />

    </LinearLayout>

    <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@string/chevron_description"
        android:src="@drawable/ic_chevron_right" />

</LinearLayout>
