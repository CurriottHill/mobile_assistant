<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_canvas"
    android:fillViewport="true"
    android:scrollbars="none"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_hero"
            android:orientation="vertical"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_logo_mark"
                    android:contentDescription="@string/aura_logo_description"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_aura_logo" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="NIMBUS"
                    android:textAllCaps="true"
                    android:textColor="@color/home_panel_title"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_chip"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="@string/home_chip_label"
                    android:textColor="@color/home_chip_text"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/textHomeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/dashboard_title"
                android:textColor="@color/home_hero_title"
                android:textSize="32sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textHomeSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/dashboard_subtitle"
                android:textColor="@color/home_hero_body"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Primary action -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_home_panel"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/textReadyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="4dp"
                android:text="@string/dashboard_summary_all_set"
                android:textColor="@color/home_panel_body"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnOpenAssistant"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/home_button_primary"
                android:text="@string/open_assistant_button"
                android:textColor="@color/home_button_primary_text" />

        </LinearLayout>

        <!-- Essentials section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginStart="4dp"
            android:letterSpacing="0.08"
            android:text="@string/dashboard_essentials_section"
            android:textAllCaps="true"
            android:textColor="@color/home_section_meta"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_home_panel"
            android:orientation="vertical">

            <include
                android:id="@+id/rowAccessibility"
                layout="@layout/item_settings_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="20dp"
                android:background="@color/home_panel_stroke" />

            <include
                android:id="@+id/rowDefaultAssistant"
                layout="@layout/item_settings_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="20dp"
                android:background="@color/home_panel_stroke" />

            <include
                android:id="@+id/rowPermissions"
                layout="@layout/item_settings_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="20dp"
                android:background="@color/home_panel_stroke" />

            <include
                android:id="@+id/rowLocation"
                layout="@layout/item_settings_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="20dp"
                android:background="@color/home_panel_stroke" />

            <include
                android:id="@+id/rowSpotify"
                layout="@layout/item_settings_row" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="20dp"
                android:background="@color/home_panel_stroke" />

            <include
                android:id="@+id/rowGoogle"
                layout="@layout/item_settings_row" />

        </LinearLayout>

        <!-- Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnTerms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="6dp"
                android:paddingVertical="6dp"
                android:text="@string/terms_link"
                android:textColor="@color/home_footer_link"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/footer_separator"
                android:textColor="@color/home_footer_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnPrivacy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="6dp"
                android:paddingVertical="6dp"
                android:text="@string/privacy_link"
                android:textColor="@color/home_footer_link"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/footer_separator"
                android:textColor="@color/home_footer_text"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnEval"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="6dp"
                android:paddingVertical="6dp"
                android:text="@string/evals_link"
                android:textColor="@color/home_footer_link"
                android:textSize="13sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
