<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_home_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_panel"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/account_title"
                android:textColor="@color/home_panel_title"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textAccountStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/account_signed_out"
                android:textColor="@color/home_panel_body"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnAccountGoogle"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="@string/account_google_continue"
                android:textColor="@color/home_button_secondary_text"
                app:icon="@drawable/ic_google_g"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@null" />

            <EditText
                android:id="@+id/inputAccountEmail"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_home_field"
                android:hint="@string/account_email_hint"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:textColor="@color/home_field_text"
                android:textColorHint="@color/home_field_hint" />

            <EditText
                android:id="@+id/inputAccountPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_home_field"
                android:hint="@string/account_password_hint"
                android:inputType="textPassword"
                android:paddingHorizontal="16dp"
                android:singleLine="true"
                android:textColor="@color/home_field_text"
                android:textColorHint="@color/home_field_hint" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAccountCreate"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/home_button_primary"
                    android:text="@string/account_create"
                    android:textColor="@color/home_button_primary_text" />

                <Button
                    android:id="@+id/btnAccountSignIn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/account_sign_in"
                    android:textColor="@color/home_button_secondary_text" />

            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressAccount"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_home_panel"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/textAccountPlan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/account_plan_placeholder"
                android:textColor="@color/home_panel_title"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textAccountUsage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/account_usage_placeholder"
                android:textColor="@color/home_panel_body"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnAccountBilling"
                style="@style/Widget.Material3.Button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/home_button_primary"
                android:text="@string/account_open_billing"
                android:textColor="@color/home_button_primary_text" />

            <Button
                android:id="@+id/btnAccountSignOut"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:text="@string/account_sign_out"
                android:textColor="@color/home_button_secondary_text" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
